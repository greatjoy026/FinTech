// This is your Prisma schema file,
// learn more about it: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LedgerAccount {
  id String @id @default(uuid())
  name String
  code String @unique
  type String
  currency String @default("USD")
  balance BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries LedgerEntry[]
}

model JournalTransaction {
  id String @id @default(uuid())
  reference String @unique
  description String
  metadata Json?
  status String
  createdAt DateTime @default(now())
  postedAt DateTime?
  entries LedgerEntry[]
}

model LedgerEntry {
  id String @id @default(uuid())
  transactionId String
  accountId String
  type String
  amount BigInt
  createdAt DateTime @default(now())
  transaction JournalTransaction @relation(fields: [transactionId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])
  @@index([accountId])
  @@index([transactionId])
}

model Wallet {
  id String @id @default(uuid())
  userId String
  currency String @default("USD")
  status String @default("ACTIVE")
  availableBalance BigInt @default(0)
  pendingBalance BigInt @default(0)
  reservedBalance BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions WalletTransaction[]
  freezes WalletFreeze[]
  financialAccountMapping FinancialWalletAccount?
}

model WalletTransaction {
  id String @id @default(uuid())
  walletId String
  reference String @unique
  type String
  amount BigInt
  status String
  metadata Json?
  requestHash String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id])
  @@index([walletId])
}

model WalletFreeze {
  id String @id @default(uuid())
  walletId String
  reason String
  frozenBy String
  unfrozenAt DateTime?
  unfrozenBy String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id])
}

model PaymentIntent {
  id String @id @default(uuid())
  reference String @unique
  amount BigInt
  currency String
  status String
  provider String @default("monime")
  providerRef String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settlement {
  id String @id @default(uuid())
  reference String @unique
  amount BigInt
  currency String
  status String
  providerRef String?
  settledAt DateTime?
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id String @id @default(uuid())
  provider String @default("monime")
  eventType String
  payload Json
  status String
  error String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  processedAt DateTime?
}

model AuditLog {
  id String @id @default(uuid())
  actor String
  action String
  resource String
  resourceId String
  outcome String @default("SUCCESS")
  requestId String?
  beforeState Json?
  afterState Json?
  metadata Json?
  integrityHash String @unique
  ipAddress String?
  device String?
  createdAt DateTime @default(now())
  @@index([actor, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([requestId])
}

model ApprovalRequest {
  id String @id @default(uuid())
  type String
  status String
  payload Json
  makerId String
  checkerId String?
  approverId String?
  rejectionRsn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FraudAlert {
  id String @id @default(uuid())
  userId String?
  walletId String?
  riskLevel String
  ruleTriggered String
  metadata Json?
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id String @id @default(uuid())
  walletId String
  amount BigInt
  currency String
  destination Json
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinancialAccountStatus {
  ACTIVE
  DISABLED
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum JournalLineDirection {
  DEBIT
  CREDIT
}

enum FinancialHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CAPTURED
}

model FinancialAccount {
  id String @id @default(uuid())
  code String @unique
  name String
  type FinancialAccountType
  currency String @db.VarChar(3)
  status FinancialAccountStatus @default(ACTIVE)
  parentId String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent FinancialAccount? @relation("FinancialAccountHierarchy", fields: [parentId], references: [id])
  children FinancialAccount[] @relation("FinancialAccountHierarchy")
  lines FinancialJournalLine[]
  walletMapping FinancialWalletAccount?
  holdsFrom FinancialHold[] @relation("HoldSourceAccount")
  holdsTo FinancialHold[] @relation("HoldDestinationAccount")
  @@index([type, status])
  @@index([currency, status])
  @@index([parentId])
}

model FinancialJournal {
  id String @id @default(uuid())
  reference String @unique
  description String
  currency String @db.VarChar(3)
  status JournalStatus @default(DRAFT)
  idempotencyKey String @unique
  requestHash String
  source String
  metadata Json?
  createdAt DateTime @default(now())
  postedAt DateTime?
  voidedAt DateTime?
  lines FinancialJournalLine[]
  @@index([status, createdAt])
  @@index([currency, status])
}

model FinancialJournalLine {
  id String @id @default(uuid())
  journalId String
  accountId String
  direction JournalLineDirection
  amount BigInt
  description String?
  metadata Json?
  createdAt DateTime @default(now())
  journal FinancialJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([journalId])
  @@index([accountId, createdAt])
}

model FinancialWalletAccount {
  id String @id @default(uuid())
  walletId String @unique
  accountId String @unique
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model FinancialHold {
  id String @id @default(uuid())
  reference String @unique
  sourceAccountId String
  destinationAccountId String
  amount BigInt
  currency String @db.VarChar(3)
  status FinancialHoldStatus @default(ACTIVE)
  idempotencyKey String @unique
  reason String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  releasedAt DateTime?
  capturedAt DateTime?
  sourceAccount FinancialAccount @relation("HoldSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("HoldDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  @@index([sourceAccountId, status])
  @@index([destinationAccountId, status])
  @@index([status, expiresAt])
}
