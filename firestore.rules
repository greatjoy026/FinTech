rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication, session and OTP data are server-authoritative.
    // The backend accesses Firestore with Google service credentials and therefore
    // does not rely on Firebase client authorization rules.
    match /users/{userId} { allow read, write: if false; }
    match /sessions/{sessionId} { allow read, write: if false; }
    match /otp_codes/{otpId} { allow read, write: if false; }

    // Default deny for every other collection until an explicit application
    // access model is designed and reviewed.
    match /{document=**} { allow read, write: if false; }
  }
}
