# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure through the deployment secret manager; never commit real credentials.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"
DATABASE_URL="postgresql://user:password@localhost:5432/monivexa"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication
# Required in every environment. Use a high-entropy secret of at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional non-production development OTP. Never configure in production.
AUTH_DEV_OTP=""

# Provider secrets are placeholders only; production values must come from a secret manager.
MONIME_API_TOKEN="replace-with-provider-token"
MONIME_WEBHOOK_SECRET="replace-with-webhook-secret"
