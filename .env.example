# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

DATABASE_URL="postgresql://user:password@localhost:5432/monivexa"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication
# REQUIRED in every environment. Use a high-entropy secret of at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional non-production OTP for local/manual development only.
# Never configure this in production. Production OTPs are generated securely.
AUTH_DEV_OTP=""

MONIME_API_TOKEN="sk_test_123"
MONIME_WEBHOOK_SECRET="whsec_123"
